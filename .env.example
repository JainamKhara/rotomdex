# ============================================================
# RotomDex — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local — it is listed in .gitignore.
# ============================================================

# ── Database ─────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, Railway, or local)
# Format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# ── NextAuth.js ───────────────────────────────────────────────
# The URL of your app (change to your production domain when deploying)
NEXTAUTH_URL="http://localhost:3000"

# A random secret used to sign session cookies
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="your-random-secret-here"
