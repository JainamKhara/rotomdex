# ============================================================
# RotomDex — .gitignore
# ============================================================

# ── Dependencies ─────────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js build output ─────────────────────────────────────
.next/
out/
build/

# ── Prisma generated client ──────────────────────────────────
# The generated Prisma Client is rebuilt via `prisma generate`
# and should never be committed — it's platform-specific
generated/

# ── Environment variables ────────────────────────────────────
# Never commit secrets. Use .env.example for reference only.
.env
.env.*
!.env.example

# ── Test coverage ─────────────────────────────────────────────
coverage/
.nyc_output/

# ── Debug logs ───────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# ── TypeScript ───────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── OS-specific ──────────────────────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverrideIcon
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~

# ── Editors & IDEs ───────────────────────────────────────────
# VS Code — keep workspace settings but ignore personal ones
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# JetBrains (WebStorm, IntelliJ, etc.)
.idea/
*.iml
*.iws
*.ipr

# Vim / Neovim
*.swp
*.swo
*.swn
Session.vim
.netrwhist

# Emacs
*~
\#*\#

# ── Vercel deployment ─────────────────────────────────────────
.vercel/

# ── Misc ─────────────────────────────────────────────────────
*.pem
*.key
.cache/
tmp/
temp/
